@page "/recipe"
@inject IRecipeRepository RecipeRepository

<PageTitle>Opskrifter | På Pinden</PageTitle>

<main class="recipes-page">
    <header class="recipes-hero">
        <div class="recipes-hero__text">
            <span class="recipes-eyebrow">PÅ PINDEN / OPSKRIFTER</span>
            <h1>Find dit næste <span>strikkeprojekt.</span></h1>
            <p>Gå på opdagelse i opskrifter, del dine idéer, og find inspiration til det næste, du vil strikke.</p>
        </div>

        @if (!ShowCreateRecipe)
        {
            <a class="recipes-primary-link" href="/recipe?createRecipe=true">
                <span aria-hidden="true">+</span>
                Opret opskrift
            </a>
        }
    </header>

    @if (ShowCreateRecipe)
    {
        <section class="recipes-create-panel" aria-labelledby="create-heading">
            <div class="recipes-section-heading">
                <div>
                    <span class="recipes-eyebrow">DEL DIN KREATIVITET</span>
                    <h2 id="create-heading">Opret en opskrift</h2>
                </div>
                <a class="recipes-back-link" href="/recipe">Tilbage til opskrifter</a>
            </div>

            <CreateRecipe SubmitUrl="/recipe" CancelUrl="/recipe" />
        </section>
    }
    else
    {
        var visibleRecipes = GetVisibleRecipes();

        <section aria-label="Find opskrifter">
            <form class="recipes-filters" method="get" action="/recipe">
                <div class="recipes-field recipes-field--search">
                    <label for="recipe-search">Søg efter opskrifter</label>
                    <div class="recipes-search-input">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m16 16 4.5 4.5"></path>
                        </svg>
                        <input id="recipe-search"
                               name="search"
                               type="search"
                               value="@Search"
                               placeholder="Søg i titel, beskrivelse eller forfatter" />
                    </div>
                </div>

                <div class="recipes-field recipes-field--sort">
                    <label for="recipe-sort">Sorter efter</label>
                    <select id="recipe-sort" name="sort">
                        <option value="ny" selected="@SortIsNy">Nyeste først</option>
                        <option value="populaert" selected="@SortIsPopulaer">Mest populære</option>
                        <option value="aeldst" selected="@SortIsAeldst">Ældste først</option>
                    </select>
                </div>

                <button class="recipes-search-button" type="submit">Søg</button>
            </form>
        </section>

        <section class="recipes-gallery" aria-labelledby="gallery-heading">
            <div class="recipes-section-heading recipes-section-heading--gallery">
                <div>
                    <span class="recipes-eyebrow">FRA FÆLLESSKABET</span>
                    <h2 id="gallery-heading">Udforsk opskrifter</h2>
                </div>
                <div class="recipes-results" role="status">
                    @visibleRecipes.Count @(visibleRecipes.Count == 1 ? "opskrift" : "opskrifter")
                </div>
            </div>

            @if (visibleRecipes.Count == 0)
            {
                <div class="recipes-empty">
                    <div class="recipes-empty__symbol" aria-hidden="true">✳</div>
                    <h3>@(string.IsNullOrWhiteSpace(Search) ? "Der er ingen opskrifter endnu" : "Vi fandt ingen opskrifter")</h3>
                    <p>
                        @(string.IsNullOrWhiteSpace(Search)
                            ? "Vær den første til at dele en strikkeopskrift med fællesskabet."
                            : "Prøv et andet søgeord, eller ryd filtrene for at se alle opskrifter.")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Search))
                    {
                        <a class="recipes-secondary-link" href="/recipe">Ryd søgning</a>
                    }
                    else
                    {
                        <a class="recipes-secondary-link" href="/recipe?createRecipe=true">Opret første opskrift</a>
                    }
                </div>
            }
            else
            {
                <div class="recipes-grid">
                    @foreach (var recipe in visibleRecipes)
                    {
                        <article class="recipe-card">
                            <div class="recipe-card__cover">
                                <span class="recipe-card__cover-tag">STRIKKEOPSKRIFT</span>
                                <svg class="recipe-card__illustration" viewBox="0 0 160 160" fill="none"
                                     stroke="currentColor" stroke-width="3" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="80" cy="91" r="39"></circle>
                                    <path d="M50 66c22-5 47 8 66 31M43 90c28-9 57 1 73 18M54 118c4-29 19-52 43-62M78 128c-2-26 8-50 28-67"></path>
                                    <path d="M112 116c14 5 18 17 29 20"></path>
                                    <path d="M51 16l42 51M87 13 66 78"></path>
                                    <path d="M46 10l9 11M82 9l10 7"></path>
                                </svg>
                            </div>

                            <div class="recipe-card__body">
                                <p class="recipe-card__author">Af @recipe.Author</p>
                                <h3 class="recipe-card__title">@recipe.Title</h3>
                                <p class="recipe-card__description">@recipe.Content</p>

                                <div class="recipe-card__footer">
                                    <span class="recipe-card__difficulty">@recipe.Difficulty</span>
                                    <span class="recipe-card__likes" aria-label="Antal likes">
                                        <span aria-hidden="true">♥</span> @recipe.Likes
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</main>

@code {
    // Værdier læses fra URL'en, så søgning og sortering også virker med SSR.
    [Parameter, SupplyParameterFromQuery(Name = "createRecipe")]
    public bool ShowCreateRecipe { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    private List<RecipeModel> Recipes = new();

    protected override async Task OnInitializedAsync()
    {
        Recipes = await RecipeRepository.GetAllRecipesAsync();
    }

    private bool SortIsNy => Sort != "populaert" && Sort != "aeldst";
    private bool SortIsPopulaer => Sort == "populaert";
    private bool SortIsAeldst => Sort == "aeldst";

    private List<RecipeModel> GetVisibleRecipes()
    {
        IEnumerable<RecipeModel> result = Recipes;

        if (!string.IsNullOrWhiteSpace(Search))
        {
            string searchTerm = Search.Trim();

            result = result.Where(recipe =>
                (recipe.Title?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (recipe.Content?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (recipe.Author?.ToString()?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        result = Sort switch
        {
            "populaert" => result.OrderByDescending(recipe => recipe.Likes),
            "aeldst" => result.OrderBy(recipe => recipe.CreatedAt),
            _ => result.OrderByDescending(recipe => recipe.CreatedAt)
        };

        return result.ToList();
    }
}
