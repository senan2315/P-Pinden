@page "/profile"
@rendermode InteractiveServer

@inject IProfileRepository ProfileRepository 
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Profil</h3>

<div class="profile-page">

    <div class="profile-header">

        <div class="profile-picture">
            Profilbillede
        </div>

        <div class="profile-info">
            <div>
                <strong>21</strong>
                <p>Følgere</p>
            </div>

            <div>
                <strong>20</strong>
                <p>Følger</p>
            </div>

            <button type="button" class="profile-button" @onclick="OpenEditProfile">
                Rediger profil
            </button>
        </div>

    </div>

    @if (isEditingProfile)
    {
        <div class="bio">
            <h4>Rediger profil</h4>

            <label>Bio</label>
            <textarea @bind="bioText" class="form-control"></textarea>
            <label>Profilbillede</label>
            <InputFile OnChange="HandleImageSelected"
                       accept="image/*"
                       class="form-control" />

            <br />
            <button type="button" class="profile-button" @onclick="SaveProfile">
                Gem ændringer
            </button>

            <button type="button" class="profile-button" @onclick="CloseEditProfile">
                Annuller
            </button>
        </div>
    }
    else
    {
        <div class="bio">
            <p>@(profile?.Bio ?? "Ingen bio endnu...")</p>
        </div>
    }

    <hr />

    <div class="posts">
        <div class="post">Opslag 1</div>
        <div class="post">Opslag 2</div>
        <div class="post">Opslag 3</div>
        <div class="post">Opslag 4</div>
        <div class="post">Opslag 5</div>
        <div class="post">Opslag 6</div>
    </div>

</div>

@code {
    private ApplicationUser? profile;
    private string bioText = "";
    private bool isEditingProfile = false;
    private IBrowserFile? selectedImage;

    private void HandleImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
    }

    private async Task SaveProfile()
    {
        if (profile != null)
        {
            profile.Bio = bioText;

            await ProfileRepository.UpdateProfileAsync(profile);

            isEditingProfile = false;
        }
    }

    private void OpenEditProfile()
    {
        bioText = profile?.Bio ?? "";
        isEditingProfile = true;
    }

    private void CloseEditProfile()
    {
        isEditingProfile = false;
    }


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            profile = await ProfileRepository.GetProfileByIdAsync(user.Id);
        }
    }
}
