@page "/"

<PageTitle>Forside | På Pinden</PageTitle>

<div class="container mt-4">

    <!-- Velkomst -->
    <div class="mb-4">
        <h2 class="fw-bold">Velkommen til På Pinden</h2>
        <p class="text-muted">
            Del dine strikkeprojekter, find inspiration
            og bliv en del af vores kreative fællesskab.
        </p>
    </div>

    <!-- Overskrift og opret opslag -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1">Det Sociale Garn</h4>
            <p class="text-muted mb-0">
                Udforsk fællesskabets nyeste opslag
            </p>
        </div>

        <a href="/post?create=true" class="btn btn-primary">
            + Opret opslag
        </a>

    </div>

    <!-- Søgning og sortering -->
    <form method="get" action="/" class="row g-3 mb-4">

        <div class="col-md-9">
            <label for="search" class="form-label">
                Søg efter opslag
            </label>

            <input id="search"
                   name="search"
                   value="@Search"
                   class="form-control"
                   placeholder="Søg i opslag, beskrivelser eller brugere..." />
        </div>

        <div class="col-md-2">
            <label for="sort" class="form-label">
                Sorter efter
            </label>

            <select id="sort" name="sort" class="form-select">
                <option value="ny" selected="@(Sort == "ny" || string.IsNullOrEmpty(Sort))">
                    Nyeste
                </option>

                <option value="populaert" selected="@(Sort == "populaert")">
                    Populært
                </option>

                <option value="aeldst" selected="@(Sort == "aeldst")">
                    Ældste
                </option>
            </select>
        </div>

        <div class="col-md-1 d-flex align-items-end">
            <button type="submit"
                    class="btn btn-outline-primary w-100">
                Søg
            </button>
        </div>

    </form>

    <!-- Feed -->
    <h4 class="mb-3">Seneste opslag</h4>

    @if (!VisiblePosts.Any())
    {
        <div class="text-center py-5">
            <h5>Ingen opslag fundet</h5>
            <p class="text-muted">
                Prøv at søge efter noget andet.
            </p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">

            @foreach (var post in VisiblePosts)
            {
                <div class="col">

                    <article class="post-card">

                        <!-- Opslagsbillede -->
                        <div class="post-image @post.BackgroundClass">
                            <span>På Pinden</span>
                        </div>

                        <!-- Opslagsinformation -->
                        <div class="post-info">

                            <h5 class="post-title">
                                @post.Title
                            </h5>

                            <p class="post-author">
                                Af @post.Author
                            </p>

                            <p class="post-description">
                                @post.Content
                            </p>

                            <div class="post-footer">

                                <span class="post-date">
                                    @post.CreatedAt.ToString("dd-MM-yyyy")
                                </span>

                                <span class="post-likes">
                                    ♥ @post.Likes
                                </span>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

</div>

<style>
    /* Firkantede opslag */
    .post-card {
        width: 100%;
        aspect-ratio: 1 / 1;
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .post-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

    /* Billedeområde */
    .post-image {
        height: 55%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #5d4636;
        font-size: 18px;
        font-weight: 600;
    }

    .yarn-cream {
        background: linear-gradient(135deg, #e8d9c5, #c5a98c);
    }

    .yarn-pink {
        background: linear-gradient(135deg, #f2d6dc, #dba8b5);
    }

    .yarn-green {
        background: linear-gradient(135deg, #d9e8d2, #a8c5a0);
    }

    .yarn-blue {
        background: linear-gradient(135deg, #d9e7ef, #a2bfce);
    }

    /* Information */
    .post-info {
        padding: 12px;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .post-title {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .post-author {
        font-size: 12px;
        color: #888;
        margin-bottom: 6px;
    }

    .post-description {
        font-size: 12px;
        color: #555;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* Dato og likes */
    .post-footer {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 5px;
        font-size: 12px;
    }

    .post-date {
        color: #888;
    }

    .post-likes {
        color: #d9536f;
        font-weight: 600;
        white-space: nowrap;
    }

    /* Mindre tekst på mobil */
    @@media (max-width: 576px) {
        .post-info {
            padding: 8px;
        }

        .post-title {
            font-size: 13px;
        }

        .post-description {
            font-size: 11px;
        }

        .post-image {
            font-size: 14px;
        }
    }
</style>

@code {

    // Query parameters

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }


    // Midlertidige testopslag
    // Erstattes senere med data fra databasen

    private List<FeedPost> Posts = new()
    {
        new FeedPost
        {
            Title = "Min første strikkede sweater",
            Author = "Sofie",
            Content = "Endelig færdig med min nye sweater!",
            Likes = 42,
            CreatedAt = new DateTime(2026, 11, 10),
            BackgroundClass = "yarn-cream"
        },

        new FeedPost
        {
            Title = "Hjemmestrikket halstørklæde",
            Author = "Emma",
            Content = "Mit seneste projekt i blødt uldgarn.",
            Likes = 28,
            CreatedAt = new DateTime(2026, 11, 9),
            BackgroundClass = "yarn-pink"
        },

        new FeedPost
        {
            Title = "Strikkede sokker",
            Author = "Maria",
            Content = "Varme sokker til vinteren.",
            Likes = 65,
            CreatedAt = new DateTime(2026, 11, 8),
            BackgroundClass = "yarn-green"
        },

        new FeedPost
        {
            Title = "Mit nye strikkeprojekt",
            Author = "Anna",
            Content = "Er begyndt på en cardigan.",
            Likes = 19,
            CreatedAt = new DateTime(2026, 11, 7),
            BackgroundClass = "yarn-blue"
        }
    };


    // Søgning og sortering

    private IEnumerable<FeedPost> VisiblePosts
    {
        get
        {
            IEnumerable<FeedPost> result = Posts;

            if (!string.IsNullOrWhiteSpace(Search))
            {
                string searchTerm = Search.Trim();

                result = result.Where(post =>
                    post.Title.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    post.Content.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    post.Author.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                );
            }

            result = Sort switch
            {
                "populaert" => result.OrderByDescending(
                    post => post.Likes),

                "aeldst" => result.OrderBy(
                    post => post.CreatedAt),

                _ => result.OrderByDescending(
                    post => post.CreatedAt)
            };

            return result;
        }
    }


    // Midlertidig model til forsiden

    private class FeedPost
    {
        public string Title { get; set; } = "";
        public string Author { get; set; } = "";
        public string Content { get; set; } = "";
        public int Likes { get; set; }
        public DateTime CreatedAt { get; set; }
        public string BackgroundClass { get; set; } = "";
    }
}
