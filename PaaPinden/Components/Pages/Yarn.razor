@page "/yarn"

<PageTitle>Garn</PageTitle>

<div class="container mt-4">

    <h2>Garnoversigt</h2>

    <p class="text-muted">
        Lær om forskellige garntyper og find det rette garn til dit strikkeprojekt.
    </p>

    <input class="form-control mb-4" type="text" placeholder="Søg efter garn.." />

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4>Merinould</h4>
                    <p>
                        Merinould er blødt og varmt garn, som egner sig godt til trøjer, huer og tørklæder.
                    </p>

                    <p><strong>Materiale:</strong> Uld</p>
                    <p><strong>Tykkelse:</strong> 3mm</p>
                    <p><strong>Egenskaber:</strong> Blødt og varmt</p>

                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4>Bomuld</h4>

                    <p>
                        Bomuld er et slidstærkt garn, der ofte bruges til karklude, sommertøj og lette projekter.
                    </p>

                    <p><strong>Materiale:</strong> Bomuld</p>
                    <p><strong>Tykkelse:</strong> 4mm</p>
                    <p><strong>Egenskaber:</strong> Åndbart og slidstærkt</p>

                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4>Alpaka</h4>

                    <p>
                        Alpaka er et let og varmt garn, der egner sig godt til bløde tørklæder og vintertøj.
                    </p>

                    <p><strong>Materiale:</strong> Alpaka</p>
                    <p><strong>Tykkelse:</strong> Worsted</p>
                    <p><strong>Egenskaber:</strong> Blødt og isolerende</p>

                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4>Akrylgarn</h4>

                    <p>
                        Akryl er et syntetisk garn, som ofte er prisvenligt og nemt at vedligeholde.
                    </p>

                    <p><strong>Materiale:</strong> Akryl</p>
                    <p><strong>Tykkelse:</strong> DK</p>
                    <p><strong>Egenskaber:</strong> Let og nemt at vaske</p>

                </div>
            </div>
        </div>

    </div>

</div>

